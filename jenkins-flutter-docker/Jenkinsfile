pipeline {
    agent any

    tools {
        sonarQubeScanner 'sonar-scanner'
    }

    stages {

        stage('Clonar Repositorio') {
            steps {
                echo 'Descargando el código desde GitHub...'

                git branch: 'master',
                    url: 'https://github.com/JaleaReal-1/ramis-front.git'

                sh '''
                    echo "===== RAMA ACTUAL ====="
                    git branch

                    echo ""
                    echo "===== ULTIMO COMMIT ====="
                    git log -1 --oneline

                    echo ""
                    echo "===== CONTENIDO DEL PROYECTO ====="
                    ls -la
                '''
            }
        }

        stage('Verificar Archivos Dart') {
            steps {
                sh '''
                    echo "===== DART FILES ====="
                    find lib -name "*.dart" | head -20

                    echo ""
                    echo "===== CANTIDAD DE ARCHIVOS DART ====="
                    find lib -name "*.dart" | wc -l

                    echo ""
                    echo "===== CONTENIDO DE LIB ====="
                    ls -la lib
                '''
            }
        }

        stage('Instalar Dependencias') {
            steps {
                echo 'Descargando paquetes Flutter...'
                sh '/opt/flutter/bin/flutter pub get'
            }
        }

        stage('Pruebas Unitarias y de Componentes') {
            steps {
                echo 'Ejecutando flutter test...'
                sh '/opt/flutter/bin/flutter test'
            }
        }

        stage('Analisis SonarQube') {
            steps {
                echo 'Enviando código fuente a SonarQube...'

                script {
                    def scannerHome = tool 'sonar-scanner'

                    withSonarQubeEnv('SonarServer') {

                        sh '''
                            echo "===== SONAR-PROJECT.PROPERTIES ====="
                            cat sonar-project.properties || true

                            echo ""
                            echo "===== ARCHIVOS EN LIB ====="
                            find lib -type f | head -50
                        '''

                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=ramis-front \
                            -Dsonar.projectName=ramis-front \
                            -Dsonar.sources=lib \
                            -Dsonar.tests=test
                        """
                    }
                }
            }
        }

        stage('Compilar APK Móvil') {
            steps {
                echo 'Construyendo el archivo ejecutable de Android...'
                sh '/opt/flutter/bin/flutter build apk --release'
            }
        }
    }

    post {

        success {
            echo '¡El pipeline terminó con éxito! Guardando el APK...'

            archiveArtifacts(
                artifacts: 'build/app/outputs/flutter-apk/app-release.apk',
                fingerprint: true
            )
        }

        failure {
            echo 'El pipeline falló.'
        }

        always {
            cleanWs()
        }
    }
}